@code
{
    bool showValue = false;
    bool showDataLabelAKUTop = true, showDataLabelAKUMiddle = true, showDataLabelAKUBottom = true, showDataLabelTemp = true;
    DateTime lastUpdateTemp = new DateTime(1983, 12, 10);
    DateTime lastUpdateTempAKUTOP = new DateTime(1983, 12, 10);
    DateTime lastUpdateTempAKUMiddle = new DateTime(1983, 12, 10);
    DateTime lastUpdateTempAKUBottom = new DateTime(1983, 12, 10);
    DateTime selectedDay = DateTime.Now;
    IEnumerable<TblEquipmentActual> colTemperatures;
    IEnumerable<AKUTempHistoryModel> colTemperaturesHistory;

    double valueAKUTOP = 0, valueAKUMiddle = 0, valueAKUBottom = 0;
    int IntervalHours = 30, TimeRange = -12;

    string lblTempAxis = "Teplota (°C)";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        colTemperatures = await ITemperatureService.LoadRec();
        if (colTemperatures != null)
        {
            valueAKUTOP = Convert.ToDouble(colTemperatures.Single(id => id.EquIoTid == 1).EquCurrentTemp);
            lastUpdateTempAKUTOP = Convert.ToDateTime(colTemperatures.Single(id => id.EquIoTid == 1).EquLastUpdate);
            valueAKUMiddle = Convert.ToDouble(colTemperatures.Single(id => id.EquIoTid == 2).EquCurrentTemp);
            lastUpdateTempAKUMiddle = Convert.ToDateTime(colTemperatures.Single(id => id.EquIoTid == 2).EquLastUpdate);
            valueAKUBottom = Convert.ToDouble(colTemperatures.Single(id => id.EquIoTid == 3).EquCurrentTemp);
            lastUpdateTempAKUBottom = Convert.ToDateTime(colTemperatures.Single(id => id.EquIoTid == 3).EquLastUpdate);

            lastUpdateTemp = DateTime.Now;
        }

        colTemperaturesHistory = await ITemperatureService.LoadAKUTempHistory(DateTime.Now, TimeRange, IntervalHours);
    }

    private async Task OnClick()
    {
        colTemperaturesHistory = await ITemperatureService.LoadAKUTempHistory(selectedDay, TimeRange, IntervalHours);
    }
}