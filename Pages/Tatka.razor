@page "/tatka"
@attribute [Authorize(Roles = "Administrator, tatka")]

@using HomeControlBlazor.Models
@using HomeControlBlazor.Services
@inject IImageRespository ImgeRepo
@inject Radzen.DialogService DialogServices

<h3>Navždy náš ...</h3>


    @if (imageList == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
            
             <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.Center" Class="rz-shadow-5 shadows rz-text-align-center rz-p-5" Gap="1rem">
                 <h4>Fotogalerie</h4>
            @foreach (var img in imageList)
            {
                <div class="col-sm-4">

                <RadzenButton Click="@((args) => OnClick(args, @img.Path, @img.Description))" ButtonStyle="ButtonStyle.Light" Style="margin-bottom: 20px; width:200px;height:200px;">
                        <RadzenImage Path="@img.ThumbnailPath" Style="width:100%" />
                    </RadzenButton>
                </div>
            }
 
        </RadzenStack>

         <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.Center" Class="rz-shadow-5 shadows rz-text-align-center rz-p-5" Gap="1rem">
           <h4>Video</h4>
            @foreach (var videoFiles in videoFileList)
            {
                <div class="col-sm-4">
                <RadzenButton Click="@((args) => OnClickSound(args, @videoFiles.Path))" ButtonStyle="ButtonStyle.Light" Style="margin-bottom: 20px; width:200px;height:200px;">
                    <RadzenImage Path="@videoFiles.Path" Style="width:100%" />
                    </RadzenButton>
                </div>
            }
          
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.Center" Class="rz-shadow-5 shadows rz-text-align-center rz-p-5" Gap="1rem">
            @*<div class="row">*@
            <h4>Zvuk</h4>
            @foreach (var img in soundFileList)
            {
                <div class="col-sm-4">
                    @*     <a href="http://www.bemalan.cz/home/@img.Path" class="tile purple">
            <h6 class="title">@img.Name</h6>
            <img src="@img.ThumbnailPath" style="width:200px;height:200px;">
            </a>*@
                    <RadzenButton Click="@((args) => OnClickSound(args, @img.Path))" ButtonStyle="ButtonStyle.Light" Style="margin-bottom: 20px; width:200px;height:200px;">
                        <RadzenImage Path="@img.Path" Style="width:100%" />
                    </RadzenButton>
                </div>
            }
            @* </div>*@
        </RadzenStack>
    }

