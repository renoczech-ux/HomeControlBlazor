            {

            }
        }
        catch(Exception ex)
        {
            ShowNotification(new NotificationMessage
            {
                // Style = "position: absolute; left: -1000px;",
                Severity = NotificationSeverity.Error,
                Summary = "Systemova chyba",
                Detail = ex.Message,
                Duration = 50000
            });
        }
        // colTemperaturesHistory = await ITemperatureService.LoadAKUTempHistory(DateTime.Now, TimeRange, IntervalHours);
    }

    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);

        //console.Log($"{message.Severity} notification");
    }

    private void OpenOrder2(int ID)
    {
        return;
    }


    async Task OpenOrder(int orderId, string ToDoName)
    {
        await DialogService.OpenAsync<DialogCardPage>($"Task: {ToDoName}",
              new Dictionary<string, object>() { { "ID", orderId } },
              new DialogOptions() { Width = "700px" }); // Height = "520px"
      
    }

    public enum Status
    {
        novy,
        v_reseni,
        hotovo
    }

    public enum TaskPriority
    {
        nizka,
        stredni,
        vysoka
    }

    public enum Category
    {
        barak,
        zahrada,
        garaz,
        auta
    }
}
