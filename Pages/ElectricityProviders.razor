@code {
    string DistributionProvider = "CEZ";
    string DistributionTarif = "D02d";
    string ElectricityBreaker = "<3x10A; <1x25A";
    DateTime SelectedDate = DateTime.Now;
    string[] arrDistributionProviders = new string[] { "CEZ", "PRE", "EGD(EON)" };
    string[] arrDistributionTarif = new string[] { "D01d", "D02d", "D25d", "D26d", "D27d", "D35d", "D45d", "D56d", "D57d", "D61d" };
    string[] arrBreakerValue = new string[] { "do 3x10A; do 1x25A", "nad 3x10A, do 3x16A vcetne",
    "nad 3x16A, do 3x20A vcetne", "nad 3x20A, do 3x25A vcetne", "nad 3x25A, do 3x32A vcetne", "nad 3x32A, do 3x40A vcetne",
    "nad 3x40A, do 3x50A vcetne", "nad 3x50A, do 3x63A vcetne", "nad 3x63A, do 3x80A vcetne", "nad 3x80A, do 3x100A vcetne",
    "nad 3x100A, do 3x125A vcetne", "nad 3x125A, do 3x160A"};
    string[] arrYear = new string[] { "2021", "2022", "2023", "2024" };
    string txtInfoMessage = "Vašim kritériům nebyly nalezeny potřebná data v databázi.";
    bool showDataLabels = false;
    bool showGraph = false, showLoading = false;
    IEnumerable<int> ElectricityProvider = new int[] { 1 };

    IEnumerable<OTEPricing> colBezDodavatele = new List<OTEPricing>();
    IEnumerable<OTEPricing> colCEZ = new List<OTEPricing>();
    IEnumerable<OTEPricing> colElectree = new List<OTEPricing>();
    IEnumerable<OTEPricing> colPriceResult = new List<OTEPricing>();

    Orientation orientation = Orientation.Horizontal;
    AlignItems alignItems = AlignItems.Center;
    JustifyContent justifyContent = JustifyContent.SpaceBetween;
    FlexWrap wrap = FlexWrap.Wrap;
    string gap = "10px";
    bool reverse;

    #region "DropDown box"
    private void OnChangeUploadFolder(object value)
    {
        // The 'value' parameter is the newly selected value from the dropdown.
        // Add your logic for the change event here.
        // MyStudentInfo.UploadFolder = value.ToString();
    }
    #endregion

    private async Task OnClick(string text)
    {
        try
        {
            showGraph = false;
            showLoading = true;
            colBezDodavatele = new List<OTEPricing>();
            colCEZ = new List<OTEPricing>();
            colElectree = new List<OTEPricing>();
            //string selectedDate = String.Format("{0}-{1}-{2}", SelectedDate.Year, SelectedDate.Month, SelectedDate.Day);
            //string baf = DistributionProvider;
            // colOTEPricing = await OTEService.LoadOTEByDate(value);
            if (ElectricityProvider.Contains(1))
            {
                colBezDodavatele = await ElectricityService.LoadPriceMWhByProvider(SelectedDate, SelectedDate.Year.ToString(), "bezDodavatele", DistributionProvider, DistributionTarif, ElectricityBreaker); // .LoadOTEByDate(DateTime.Now, );
                showGraph = true;
            }
            if (ElectricityProvider.Contains(2))
            {
                colCEZ = await ElectricityService.LoadPriceMWhByProvider(SelectedDate, SelectedDate.Year.ToString(), "CEZ", DistributionProvider, DistributionTarif, ElectricityBreaker);
                showGraph = true;
            }
            if (ElectricityProvider.Contains(3))
            {
                colElectree = await ElectricityService.LoadPriceMWhByProvider(SelectedDate, SelectedDate.Year.ToString(), "Electree", DistributionProvider, DistributionTarif, ElectricityBreaker);
                showGraph = true;
            }

            if (showGraph == false)
            {
                NotificationMessage msg = new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Výsledek hledání",
                        Detail = "Na základě hledaných kritérií neexistují data pro zobrazení potřebných výsledků.",
                        Duration = 5000
                    };
                ShowNotification(msg);
            }

            colPriceResult = new List<OTEPricing>();
            colPriceResult = await ElectricityService.LoadPriceMWhByProviderResults(colBezDodavatele.ToList(), colCEZ.ToList(), colElectree.ToList());
            showLoading = false;
        }
        catch (Exception ex)
        {
            //txtInfoMessage = "Dle zvolených kritérií nebylo možné poskytnout jakékoliv data.";
            NotificationMessage msg = new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Chyba",
                    Detail = txtInfoMessage,
                    Duration = 5000
                };
            ShowNotification(msg);
            showGraph = false;

        }
        finally
        {
            showLoading = false;
        }
    }

    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);

        //console.Log($"{message.Severity} notification");
    }
}
