            </RadzenText>
        </RadzenCard>
        <RadzenCard class="p-1 rz-text-align-center">
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">
                Typ jistice:
                <RadzenDropDown TValue="string" @bind-Value=@ElectricityBreaker Data=@arrBreakerValue />
            </RadzenText>
        </RadzenCard>
        <RadzenCard class="p-1 rz-text-align-center">
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">
                Rok:
                @*  <RadzenDropDown TValue="string" @bind-Value=@Year Data=@arrYear  Style="width: 50%" /> *@
                <RadzenDatePicker @bind-Value=@SelectedDate Name="RadzenDatePickerBindValue" DateFormat="dd.MM.yyyy" ShowCalendarWeek />
            </RadzenText>
        </RadzenCard>
        @*     </RadzenStack>
        </RadzenCard>

        <RadzenCard class="p-0">
        <RadzenStack Orientation="@orientation" Gap="@gap" Reverse="@reverse" JustifyContent="@justifyContent" AlignItems="@alignItems" Wrap="@wrap" Style="height: 50px">   class="mb-5" *@
        <RadzenCard class="p-1 rz-text-align-center">
            Dodavatel:
            <RadzenCheckBoxList @bind-Value=@ElectricityProvider TValue="int">
                <Items>
                    <RadzenCheckBoxListItem Text="CEZ Prodej" Value="2" />
                    <RadzenCheckBoxListItem Text="bezDodavatele" Value="1" />
                    <RadzenCheckBoxListItem Text="Electree" Value="3" />
                    <RadzenCheckBoxListItem Text="Tedom" Value="4" Disabled=true />
                </Items>
            </RadzenCheckBoxList>
        </RadzenCard>
        @*  <RadzenCard class="p-1 rz-text-align-center"> *@
        <RadzenButton Click=@(args => OnClick("Primary button")) Text="Nacist" ButtonStyle="ButtonStyle.Primary" />
        @*  </RadzenCard> *@
    </RadzenStack>
</RadzenCard>


