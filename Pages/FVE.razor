    string FormatAsTime(object value)
    {
        if (value != null)
        {
            return Convert.ToDateTime(value).ToString("HH:mm");
        }

        return string.Empty;
    }

    string FormatAsHour(object value)
    {
        if (value != null)
        {
            TimeSpan ts = TimeSpan.Parse(value.ToString());
            return ts.Hours.ToString(); // Convert.ToDateTime(value).Hour.ToString();
        }

        return string.Empty;
    }

    int retMaxValue(object value)
    {
        if (value != null)
        {

            return (Convert.ToInt32(value) + 50);
        }
        return Convert.ToInt32(value);
    }

