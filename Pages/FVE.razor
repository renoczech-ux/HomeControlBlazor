@page "/fve"
@attribute [Authorize(Roles = "Administrator")]

@using Radzen
@using Microsoft.EntityFrameworkCore
@using HomeControlBlazor.Models
@using HomeControlBlazor.Services
@using System.Globalization
@using System.Timers;

@inject NotificationService NotificationService
@inject TooltipService tooltipService
@inject IFVEService IFVEServices
@inject DialogService DialogService
@inject NavigationManager navManager

@if (colElectricitySolar == null)
{
    <div class="rz-m-12">
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </div>

}
else
{
    <h4>FVE</h4>
    <h6>Last update: @lastUpdateSolar.ToString("dd.MM. HH:mm:ss")</h6>
    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.Center" Class="rz-shadow-5 shadows rz-p-12" Gap="1rem">

        @* <RadzenRow class="rz-text-align-center" Gap="1rem">*@
        <RadzenColumn Size="12" SizeXS="11" SizeSM="10" SizeMD="9" SizeLG="8" SizeXL="7" SizeXX="6" class="rz-p-5">
