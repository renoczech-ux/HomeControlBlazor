@code {
    //@* Min="0" Max="1000" Step="100"*@
    bool showDataLabelsPVForecast = true;
    bool showDataLabelsFVEMax = true;
    bool showDataLabelsFVEMin = true;
    bool showDataLabelsFVEPowerLabel = true;
    bool showGraphPVForecast = true;
    bool showGraphSolarMin = false;
    bool showGraphSolarMax = true;
    bool showValue = false;
    double value = 100;
    double valueSolarVoltage = 0, valueSolarCurrent = 0, valueSolarPower = 0, valueSolarTemp = 0, valueSolarPowerDay = 0, valueSolarPowerHour = 0;
    DateTime lastUpdateSolar = new DateTime(1983, 12, 10);
    bool trend = true;
    bool median = false;
    bool mean = false;
    bool mode = false;
    int tempHourMax = 1;
    int maxSolarPowerHour = 1;

    IEnumerable<TblSolarPowerSystem> colElectricitySolar;
    IEnumerable<TblPvforecast> colPVForecast;
    List<SolarRecords> colSolarValueMax = new System.Collections.Generic.List<SolarRecords>();
    List<SolarRecords> colSolarValueMin = new System.Collections.Generic.List<SolarRecords>();
    List<SolarRecords> colTempValueMax = new System.Collections.Generic.List<SolarRecords>();
    List<SolarRecords> colSolarPowerHour = new System.Collections.Generic.List<SolarRecords>();
    List<SolarRecords> colSolarPowerDay = new System.Collections.Generic.List<SolarRecords>();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
       await LoadData();
    }

    public async Task LoadData()
    {
        try
        {
            colElectricitySolar = await IFVEServices.LoadRecSolarSystem(DateTime.Now);
            if (colElectricitySolar != null)
            {
                colElectricitySolar = colElectricitySolar.OrderByDescending(date => date.SpsDateTime);

                valueSolarVoltage = Convert.ToDouble(colElectricitySolar.First().SpsVoltage);
                valueSolarCurrent = Convert.ToDouble(colElectricitySolar.First().SpsCurrent);
                valueSolarPower = Convert.ToDouble(colElectricitySolar.First().SpsPower);
                valueSolarTemp = Convert.ToDouble(colElectricitySolar.First().SpsTemperature);
                valueSolarPowerHour = Convert.ToDouble(colElectricitySolar.First().SpsEnergyHrAccWh);
                valueSolarPowerDay = Convert.ToDouble(colElectricitySolar.First().SpsEnergyDayAcc);

                lastUpdateSolar = colElectricitySolar.First().SpsDateTime;

                //var result = colElectricitySolar.GroupBy(element => element.SpsDateTime.Hour)
                //     .SelectMany(group => group.Where(element => element.SpsVoltage == group.Max(obj => obj.SpsVoltage)));

                var byHourMax = colElectricitySolar.GroupBy(r => r.SpsDateTime.Hour).Select(g => new { Hour = g.Key, MaxPower = g.Max(r => r.SpsPower) });
                foreach (var lclValue in byHourMax)
                {
                    SolarRecords lclItem = new SolarRecords();
                    lclItem.Hour = lclValue.Hour;
                    lclItem.Power = Convert.ToDouble(lclValue.MaxPower);
                    colSolarValueMax.Add(lclItem);
                }

                var byHourMin = colElectricitySolar.GroupBy(r => r.SpsDateTime.Hour).Select(g => new { Hour = g.Key, MaxPower = g.Min(r => r.SpsPower) });
                foreach (var lclValue in byHourMin)
                {
                    SolarRecords lclItem = new SolarRecords();
                    lclItem.Hour = lclValue.Hour;
                    lclItem.Power = Convert.ToDouble(lclValue.MaxPower);
                    colSolarValueMin.Add(lclItem);
                }

                var byPowerHour = colElectricitySolar.GroupBy(r => r.SpsDateTime.Hour).Select(g => new { Hour = g.Key, PowerHour = g.Max(r => r.SpsEnergyHrAccWh) });
                foreach (var lclValue in byPowerHour)
                {
                    SolarRecords lclItem = new SolarRecords();
                    lclItem.Hour = lclValue.Hour;
                    lclItem.PowerHour = Convert.ToDouble(lclValue.PowerHour);
                    colSolarPowerHour.Add(lclItem);
                }

                var byPowerDay = colElectricitySolar.GroupBy(r => r.SpsDateTime.Hour).Select(g => new { Hour = g.Key, PowerDay = g.Max(r => r.SpsEnergyDayAcc) });
                foreach (var lclValue in byPowerDay)
                {
                    SolarRecords lclItem = new SolarRecords();
                    lclItem.Hour = lclValue.Hour;
                    lclItem.PowerDay = Convert.ToDouble(lclValue.PowerDay * 1000);
                    colSolarPowerDay.Add(lclItem);
                }
                maxSolarPowerHour = byPowerDay.Max(item => item.Hour) + 1;


                var byTempMax = colElectricitySolar.GroupBy(r => r.SpsDateTime.Hour).Select(g => new { Hour = g.Key, Temp = g.Max(r => r.SpsTemperature) });
                foreach (var lclValue in byTempMax)
                {
                    SolarRecords lclItem = new SolarRecords();
                    lclItem.Hour = lclValue.Hour;
                    lclItem.Temp = Convert.ToDouble(lclValue.Temp);
                    colTempValueMax.Add(lclItem);
                }
                tempHourMax = byTempMax.Max(item => item.Hour);
            }
            else
            {
                valueSolarVoltage = 0;
                valueSolarCurrent = 0;
                valueSolarPower = 0;
                lastUpdateSolar = new DateTime(1983, 12, 10);
            }

            colPVForecast = await IFVEServices.LoadPVForecastRecords(DateTime.Now);
            //if (colPVForecast != null)
            //{
            //    foreach (TblPvforecast item in colPVForecast)
            //    {
            //        colPVForecast.
            //    }
            //}

            StartTimer();
        }
        catch(Exception ex)
        {
            NotificationMessage msg = new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Communication error",
                    Detail = ex.Message,
                    Duration = 5000
                };
            ShowNotification(msg);
        }
    }

