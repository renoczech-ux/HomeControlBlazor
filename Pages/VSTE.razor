    void OnProgress(UploadProgressArgs args, string name)
    {
        // console.Log($"{args.Progress}% '{name}' / {args.Loaded} of {args.Total} bytes.");
        if (args.Total > 30000000)
        {
            ShowNotification(new NotificationMessage
                {
                    //Style = "position: absolute; left: -1000px;",
                    Severity = NotificationSeverity.Error,
                    Summary = "Chyba pri uploadu souboru",
                    Detail = String.Format("Maximalni velikost souboru je 30MB. Velikost souboru: {0}B", args.Total.ToString()),
                    Duration = 40000
                });
            return;
        }

        this.info = $"{args.Progress}% '{name}' / {args.Loaded} of {args.Total} bytes.";
        this.progress = args.Progress;

        if (args.Progress == 100)
        {
            foreach (var file in args.Files)
            {
                // console.Log($"Uploaded: {file.Name} / {file.Size} bytes");
                ShowNotification(new NotificationMessage
                    {
                        Style = "position: absolute; left: -1000px;",
                        Severity = NotificationSeverity.Success,
                        Summary = "Vybrany soubor byl nahran",
                        Detail = String.Format("Velikost souboru: {0}B", args.Total.ToString()),
                        Duration = 40000
                    });
            }
        }
    }

